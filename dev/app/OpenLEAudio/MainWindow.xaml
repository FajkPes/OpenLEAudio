<Window
    x:Class="OpenLEAudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenLEAudio"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenLEAudio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <muxc:NavigationView x:Name="Nav"
                         PaneDisplayMode="Left"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         OpenPaneLength="200"
                         SelectionChanged="PageChanged">

        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Setup" Tag="setup">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9F5;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Devices" Tag="devices" IsSelected="True">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE702;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Settings" Tag="settings">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>
        <muxc:NavigationView.FooterMenuItems>
            <muxc:NavigationViewItem Content="Language" Tag="language">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="O aplikaci" Tag="about">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.FooterMenuItems>

        <Grid>
            <!-- ============================== SETUP ========================== -->
            <ScrollViewer x:Name="SetupPage" Visibility="Collapsed"
                          HorizontalContentAlignment="Stretch">
                <Grid MaxWidth="1200" Padding="32,20" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Initial setup" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="Prepare the driver, choose the Bluetooth adapter and configure the virtual audio cable."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <muxc:InfoBar x:Name="SetupNotice" IsOpen="False" IsClosable="True"
                                      Severity="Informational" HorizontalAlignment="Stretch" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Width="34" Height="34" CornerRadius="17"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Sign the driver" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Create a temporary local certificate and sign the WinUSB driver package before the first installation. Renew the signature every two years."
                                               TextWrapping="Wrap" LineHeight="20" />
                                    <TextBlock Text="The signing script removes the private signing key after installation. Secure Boot stays enabled because Windows loads Microsoft's WinUSB.sys."
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Sign driver" Tag="sign" Click="SetupActionClicked"
                                        VerticalAlignment="Center" MinWidth="150" />
                            </Grid>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Width="34" Height="34" CornerRadius="17"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Install and configure VB-CABLE" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Install VB-Audio Virtual Cable, then let OpenLEAudio set it to 48 kHz / 16-bit and use it as the Windows playback route. The original audio settings are backed up for restoration."
                                               TextWrapping="Wrap" LineHeight="20" />
                                    <HyperlinkButton Content="VB-CABLE website" NavigateUri="https://vb-audio.com/Cable/"
                                                     Padding="0" HorizontalAlignment="Left" />
                                </StackPanel>
                                 <StackPanel Grid.Column="2" Spacing="8" MinWidth="170">
                                    <Button Content="Install VB-CABLE" Tag="vbcable-install" Click="SetupActionClicked" HorizontalAlignment="Stretch" />
                                    <Button Content="Configure VB-CABLE" Tag="vbcable-setup" Click="SetupActionClicked" HorizontalAlignment="Stretch" />
                                    <Button Content="Check VB-CABLE" Tag="vbcable-status" Click="SetupActionClicked" HorizontalAlignment="Stretch" />
                                    <Button Content="Restore VB-CABLE" Tag="vbcable-restore" Click="SetupActionClicked" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Border Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="Choose and verify the Bluetooth adapter" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Select the dedicated USB adapter that OpenLEAudio may take over. Detection uses the hardware IDs from the signed driver package and works on both the Windows Bluetooth driver and WinUSB."
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <ComboBox x:Name="SetupAdapterBox" HorizontalAlignment="Stretch"
                                              PlaceholderText="Detecting Bluetooth adapters…"
                                              SelectionChanged="SetupAdapterChanged" />
                                    <Button Grid.Column="1" Content="Detect again" Click="DetectAdaptersClicked" />
                                </Grid>
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="7" Padding="14,10">
                                    <TextBlock x:Name="SetupAdapterDetails" Text="No adapter selected."
                                               TextWrapping="Wrap" LineHeight="20" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="SetupBindButton" Content="Switch to our stack" Tag="adapter-bind" Click="SetupActionClicked" />
                                    <Button Content="Restore Windows driver" Tag="adapter-restore" Click="SetupActionClicked" />
                                    <Button Content="Driver status" Tag="adapter-status" Click="SetupActionClicked" />
                                </StackPanel>
                                <TextBlock Text="LE is checked from the controller generation and Windows device data. Final LE Audio compatibility is confirmed safely after switching by reading the controller's LE feature set and the headset's GATT PACS/ASCS services; unsupported codec or channel configurations are rejected before streaming."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border Width="34" Height="34" CornerRadius="17"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Restart the app" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Close OpenLEAudio completely from the notification-area icon and start it again. The new process will open the selected WinUSB adapter and verify its Bluetooth 5.2+ LE Isochronous Channels support before scanning for LE Audio devices."
                                               TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============================ ZAŘÍZENÍ ============================ -->
            <Grid x:Name="DevicesPage" RowDefinitions="Auto,Auto,*,Auto" Padding="32,20,32,20"
                  RowSpacing="16" MaxWidth="1500" HorizontalAlignment="Stretch">

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock Text="Bluetooth and devices" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="AdapterDetail" Text="Starting..."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>

                <!-- The radio, and the one control that owns it. -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,14">
                    <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="14">
                        <FontIcon Grid.Column="0" Glyph="&#xE702;" FontSize="20"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Bluetooth" FontSize="15" />
                            <TextBlock x:Name="ScanStatus" Text="Starting..." FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <muxc:ProgressRing x:Name="Busy" IsActive="False"
                                                   Width="20" Height="20" VerticalAlignment="Center" />
                                <Button x:Name="ScanButton" Content="Hledat znovu"
                                        Click="ScanClicked" VerticalAlignment="Center" />
                                 <ToggleSwitch x:Name="AdapterSwitch"
                                               OnContent="Zapnuto" OffContent="Vypnuto"
                                               Toggled="AdapterToggled" VerticalAlignment="Center"
                                               FlowDirection="RightToLeft" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">

                        <!-- Remembered devices, above everything, exactly as the
                             Windows page groups them. These are here before any
                             scan finds them: they are known, not discovered. -->
                        <StackPanel Spacing="8" x:Name="PairedSection">
                            <TextBlock Text="Paired devices" FontSize="15"
                                       FontWeight="SemiBold" />
                            <ListView x:Name="PairedList" SelectionMode="None"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="8" Padding="8">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DeviceRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                              ColumnSpacing="14" Padding="8,10">
                                            <FontIcon Grid.Column="0" Glyph="{Binding Glyph}"
                                                      FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Visibility="{Binding BadgeVisibility}"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Button Grid.Column="3" Content="{Binding ActionLabel}"
                                                    Tag="{Binding Address}" Click="ConnectClicked"
                                                    MinWidth="92" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Content="{Binding UnpairLabel}"
                                                    Tag="{Binding Address}" Click="ForgetClicked"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Everything else the scan turned up. -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Discovered devices" FontSize="15" FontWeight="SemiBold" />
                            <ListView x:Name="DeviceList" SelectionMode="None"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1" CornerRadius="8" Padding="8"
                                      MinHeight="80">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DeviceRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14"
                                              Padding="8,10">
                                            <FontIcon Grid.Column="0" Glyph="{Binding Glyph}"
                                                      FontSize="20" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="14" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Signal}"
                                                       FontSize="12" MinWidth="64"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button Grid.Column="3" Content="{Binding ActionLabel}"
                                                    Tag="{Binding Address}" Click="ConnectClicked"
                                                    MinWidth="92" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The log belongs on this page. While the stack is being brought
                     up it is the most useful control here, and hiding it behind a
                     tab means a failure looks like nothing happening at all. -->
                <Expander Grid.Row="3" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              HorizontalAlignment="Stretch">
                            <TextBlock Grid.Column="0" Text="Activity" VerticalAlignment="Center" />
                            <ScrollViewer Grid.Column="1" HorizontalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                                          ZoomMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Right">
                                    <ToggleSwitch x:Name="DebugLogSwitch"
                                                  OnContent="Debug on"
                                                  OffContent="Debug off"
                                                  Toggled="DebugLogToggled"
                                                  ToolTipService.ToolTip="Detailed HCI, ACL, and ISO packets. Turning debug off clears the detailed log." />
                                    <ToggleSwitch x:Name="FollowLogSwitch"
                                                  OnContent="Follow on"
                                                  OffContent="Follow off"
                                                  Toggled="FollowLogToggled" />
                                    <Button Content="↓ Bottom" Click="ScrollLogBottomClicked"
                                            ToolTipService.ToolTip="Jump to the end and follow new entries again" />
                                    <Button x:Name="CopyLogButton" Content="Copy all"
                                            Click="CopyLogClicked" />
                                    <Button Content="Vymazat" Click="ClearLogClicked" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <ScrollViewer x:Name="LogScroller" Height="180"
                                      VerticalScrollBarVisibility="Auto"
                                      ViewChanged="LogViewChanged">
                            <TextBlock x:Name="LogText" IsTextSelectionEnabled="True"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="18">
                                <TextBlock x:Name="SignalMetric" Text="Signal: -"
                                           FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="LossMetric" Text="Lost packets (60 s): 0"
                                           FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="StabilityMetric" Text="Connection: waiting for data"
                                           FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </Grid>

            <!-- ============================ NASTAVENÍ =========================== -->
            <!-- The page itself never scrolls. SettingsHost owns exactly one
                 scrolling layer for the selected layout, which keeps pointer,
                 wheel and keyboard input deterministic. -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed" Padding="32,20"
                  RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14"
                  MaxWidth="1500" HorizontalAlignment="Stretch">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Values are saved automatically and persist after restart."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <!-- A reconnect notice belongs to the page flow. Overlaying
                         it on the panels hid the bottom slider rows on short
                         windows and made the controls look broken. -->
                    <muxc:InfoBar Grid.Row="1" x:Name="SettingsNotice" IsOpen="False" IsClosable="True"
                                  Severity="Informational" HorizontalAlignment="Stretch" />

                    <StackPanel Grid.Row="2" x:Name="PresetHost" />

                    <!-- Three thematic panels. They use three columns at the
                         normal window size and reflow at narrow widths; each
                         panel always owns exactly one vertical scrollbar. -->
                    <Grid Grid.Row="3" x:Name="SettingsHost" ColumnSpacing="16" RowSpacing="16"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           MinHeight="240" />

                    <Button Grid.Row="4" Content="Restore default settings" Click="ResetSettingsClicked"
                            HorizontalAlignment="Left" />
            </Grid>

            <!-- ============================== LANGUAGE ======================= -->
            <Grid x:Name="LanguagePage" Visibility="Collapsed" Padding="32,20"
                  RowDefinitions="Auto,*" RowSpacing="16"
                  MaxWidth="1500" HorizontalAlignment="Stretch">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Text="Language" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the interface language or manage custom translations."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <muxc:InfoBar Grid.RowSpan="2" x:Name="LanguageNotice" IsOpen="False" IsClosable="True"
                                  Severity="Informational" MaxWidth="720"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,8,8" Canvas.ZIndex="10" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="LanguageHost" Spacing="16" MaxWidth="900"
                                    HorizontalAlignment="Left" />
                    </ScrollViewer>
            </Grid>

            <!-- =========================== O APLIKACI ========================== -->
            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed"
                           HorizontalContentAlignment="Stretch">
                <Grid MaxWidth="1500" Padding="32,20" HorizontalAlignment="Stretch">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="OpenLEAudio" FontSize="28" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="0.9 Beta" FontSize="12"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="An open and configurable Bluetooth LE Audio client"
                                   FontSize="14" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="How OpenLEAudio works" FontSize="19" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21"
                                       Text="The client captures stereo audio from the selected Windows output, splits it into left and right channels, encodes each channel with LC3, and sends timed ISO packets directly to the Bluetooth controller. GATT and ASCS signaling discovers headset capabilities, configures the codec and QoS, and only then starts the stream." />
                            <TextBlock Text="Windows audio → stereo capture → LC3 L/R → ISO SDU → CIS → headphones"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="AboutDetailsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="16" RowSpacing="16">
                        <Border x:Name="AboutAseCard" Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="9">
                                <TextBlock Text="ASE a CIS" FontSize="19" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap" LineHeight="21"
                                           Text="An ASE is an audio endpoint exposed by the headset through ASCS. Stereo normally uses two Sink ASEs, one mapped to Front Left and one to Front Right. Both requests are sent together so the channels start synchronously." />
                                <TextBlock TextWrapping="Wrap" LineHeight="21"
                                           Text="Each active ASE maps to a CIS in one CIG. A CIS carries the LC3 stream for its assigned channel. If a device supports stereo in one stream, the client can use one CIS with both channels. Configuration is constrained by the discovered PACS and ASE capabilities." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="AboutWindowsCard" Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Windows-compatible behavior with configurable choices" FontSize="19" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap" LineHeight="21"
                                           Text="The default preset follows observed Windows LE Audio behavior: 48 kHz LC3, compatible ASCS operation ordering, atomic configuration of both ASEs, and similar QoS. This is an independent implementation of Bluetooth LE Audio standards, not a copy of the Microsoft driver." />
                                <TextBlock TextWrapping="Wrap" LineHeight="21"
                                           Text="Unlike the system driver, OpenLEAudio exposes LC3 bitrate, frame duration, PHY, retransmissions, latency, and presentation delay. The Windows-like preset is the recommended starting point. Custom mode unlocks individual values." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="AboutMappingGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="16" RowSpacing="16">
                        <Border x:Name="AboutMappingCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Discovery, GATT and capability mapping" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Discovery finds LE advertisements and known bonds. After encryption, the GATT client reads PACS codec records, audio locations and supported contexts, then discovers ASCS control points and ASE endpoints. OpenLEAudio maps those declared capabilities to a valid LC3 configuration instead of assuming that every headset supports every preset."
                                           TextWrapping="Wrap" LineHeight="21" />
                                <TextBlock Text="The mapping is explicit: Windows capture endpoint → PCM stereo → channel allocation → LC3 frames → ISO SDUs → one or two CIS links. Optional Source ASE audio can return the headset microphone to a separate virtual cable."
                                           TextWrapping="Wrap" LineHeight="21" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="AboutStackCard" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel Spacing="9">
                                <TextBlock Text="A user-mode stack with safety boundaries" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="The dedicated adapter is bound per device to Microsoft's WinUSB driver. The OpenLEAudio user-mode stack owns HCI, ACL/L2CAP, ATT/GATT, SMP pairing, BAP signalling and ISO transport while other adapters can stay under Windows. No custom kernel code is loaded."
                                           TextWrapping="Wrap" LineHeight="21" />
                                <TextBlock Text="Vendor-specific HCI commands are blocked, GATT writes are limited to handles found during discovery, packet lengths are validated and output passes through a limiter. The original adapter and VB-CABLE state can be restored from Setup."
                                           TextWrapping="Wrap" LineHeight="21" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Credits" FontSize="19" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="FajkPes" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Claude Code  •  ChatGPT Codex" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
